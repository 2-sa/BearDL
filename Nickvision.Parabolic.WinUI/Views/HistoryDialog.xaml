<ContentDialog
    x:Class="Nickvision.Parabolic.WinUI.Views.HistoryDialog"
    x:Name="DialogRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nickvision="using:Nickvision.Desktop.WinUI.Controls"
    xmlns:parabolic="using:Nickvision.Parabolic.WinUI.Helpers"
    Style="{StaticResource DefaultContentDialogStyle}"
    TitleTemplate="{StaticResource DialogHeadingTemplate}"
    DefaultButton="Primary" Loaded="Dialog_Loaded">
    <Grid Width="498" MaxWidth="498" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource InsetSurfaceStyle}" Margin="0,0,20,0" parabolic:ScrollViewportHelper.ReserveScrollbarRight="20">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="SearchBox" Style="{StaticResource PageSearchStyle}" QueryIcon="Find" TextChanged="SearchBox_TextChanged"/>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnSort" Style="{StaticResource PageActionStyle}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE8CB;"/>
                            <TextBlock VerticalAlignment="Center" x:Name="LblSort"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem x:Name="TglSortNewest" GroupName="Sort" Click="TglSort_Click"/>
                                <RadioMenuFlyoutItem x:Name="TglSortOldest" GroupName="Sort" Click="TglSort_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="BtnClearAll" Grid.Column="1" Style="{StaticResource PageActionStyle}" Click="ClearAll">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE74D;"/>
                            <TextBlock VerticalAlignment="Center" x:Name="LblClearAll"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" MaxHeight="420" MinHeight="180" FlowDirection="LeftToRight" Padding="0,0,20,0" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" parabolic:ScrollViewportHelper.ConstrainContentWidth="True">
            <nickvision:ViewStack x:Name="ViewStack" FlowDirection="{Binding FlowDirection, ElementName=DialogRoot}">
                <nickvision:ViewStack.Pages>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,24"><ProgressRing IsActive="True" Width="32" Height="32"/><TextBlock x:Name="LblLoading" Style="{StaticResource SupportingTextStyle}"/></StackPanel>
                    <nickvision:StatusPage x:Name="StatusNone" Margin="0,24" Glyph="&#xE81C;" IsCompact="True"/>
                    <nickvision:StatusPage x:Name="StatusNoneSearch" Margin="0,24" Glyph="&#xE721;" IsCompact="True"/>
                    <ListView x:Name="ListDownloads" SelectionMode="None" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="parabolic:BindableHistoricDownloadSelectionItem">
                                <Border Style="{StaticResource PageSurfaceStyle}" Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind Value.Url, Mode=OneWay}" Style="{StaticResource SupportingTextStyle}" FlowDirection="LeftToRight" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Value.Url, Mode=OneWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Name="DownloadAgainAction" Style="{StaticResource IconActionStyle}" Loaded="ActionButton_Loaded" Click="DownloadAgain" Tag="{x:Bind Value.Url, Mode=OneWay}">
                                                <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE896;" FontSize="16"/>
                                            </Button>
                                            <Button Name="PlayAction" Style="{StaticResource IconActionStyle}" Loaded="ActionButton_Loaded" Click="Play" Tag="{x:Bind Value.Path, Mode=OneWay}" IsEnabled="{x:Bind Value.ExistsOnDisk, Mode=OneWay}">
                                                <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="16"/>
                                            </Button>
                                            <Button Name="RemoveAction" Style="{StaticResource IconActionStyle}" Loaded="ActionButton_Loaded" Click="Remove" Tag="{x:Bind Value.Url, Mode=OneWay}">
                                                <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE894;" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </nickvision:ViewStack.Pages>
            </nickvision:ViewStack>
        </ScrollViewer>
    </Grid>
</ContentDialog>
