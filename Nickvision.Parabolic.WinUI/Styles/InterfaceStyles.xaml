<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="BearAccentBrush" Color="#C93B31"/>
            <SolidColorBrush x:Key="BearAccentHoverBrush" Color="#B53228"/>
            <SolidColorBrush x:Key="BearAccentPressedBrush" Color="#9E2A21"/>
            <SolidColorBrush x:Key="BearAccentBorderBrush" Color="#339E2A21"/>
            <SolidColorBrush x:Key="BearAccentSubtleBrush" Color="#18C93B31"/>
            <SolidColorBrush x:Key="BearAccentSubtleBorderBrush" Color="#45C93B31"/>
            <SolidColorBrush x:Key="BearAccentForegroundBrush" Color="#B32D24"/>
            <SolidColorBrush x:Key="BearOnAccentBrush" Color="#FFFFFF"/>

            <SolidColorBrush x:Key="BearCardBrush" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="BearElevatedSurfaceBrush" Color="#EBFFFFFF"/>
            <SolidColorBrush x:Key="BearCardBorderBrush" Color="#17000000"/>
            <SolidColorBrush x:Key="BearSubtleHoverBrush" Color="#0D000000"/>
            <SolidColorBrush x:Key="BearThumbnailBgBrush" Color="#FFEAECEF"/>

            <SolidColorBrush x:Key="BearStatusRunningBgBrush" Color="#1A2563EB"/>
            <SolidColorBrush x:Key="BearStatusRunningFgBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="BearStatusSuccessBgBrush" Color="#1A1A7F37"/>
            <SolidColorBrush x:Key="BearStatusSuccessFgBrush" Color="#157F3D"/>
            <SolidColorBrush x:Key="BearStatusWarningBgBrush" Color="#1AB45309"/>
            <SolidColorBrush x:Key="BearStatusWarningFgBrush" Color="#B45309"/>
            <SolidColorBrush x:Key="BearStatusErrorBgBrush" Color="#1ACF222E"/>
            <SolidColorBrush x:Key="BearStatusErrorFgBrush" Color="#CF222E"/>
            <SolidColorBrush x:Key="BearNeutralPillBgBrush" Color="#0D000000"/>
            <SolidColorBrush x:Key="BearNeutralPillFgBrush" Color="#B3000000"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BearAccentBrush" Color="#C93B31"/>
            <SolidColorBrush x:Key="BearAccentHoverBrush" Color="#B53228"/>
            <SolidColorBrush x:Key="BearAccentPressedBrush" Color="#9E2A21"/>
            <SolidColorBrush x:Key="BearAccentBorderBrush" Color="#339E2A21"/>
            <SolidColorBrush x:Key="BearAccentSubtleBrush" Color="#18C93B31"/>
            <SolidColorBrush x:Key="BearAccentSubtleBorderBrush" Color="#45C93B31"/>
            <SolidColorBrush x:Key="BearAccentForegroundBrush" Color="#B32D24"/>
            <SolidColorBrush x:Key="BearOnAccentBrush" Color="#FFFFFF"/>

            <SolidColorBrush x:Key="BearCardBrush" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="BearElevatedSurfaceBrush" Color="#EBFFFFFF"/>
            <SolidColorBrush x:Key="BearCardBorderBrush" Color="#17000000"/>
            <SolidColorBrush x:Key="BearSubtleHoverBrush" Color="#0D000000"/>
            <SolidColorBrush x:Key="BearThumbnailBgBrush" Color="#FFEAECEF"/>

            <SolidColorBrush x:Key="BearStatusRunningBgBrush" Color="#1A2563EB"/>
            <SolidColorBrush x:Key="BearStatusRunningFgBrush" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="BearStatusSuccessBgBrush" Color="#1A1A7F37"/>
            <SolidColorBrush x:Key="BearStatusSuccessFgBrush" Color="#157F3D"/>
            <SolidColorBrush x:Key="BearStatusWarningBgBrush" Color="#1AB45309"/>
            <SolidColorBrush x:Key="BearStatusWarningFgBrush" Color="#B45309"/>
            <SolidColorBrush x:Key="BearStatusErrorBgBrush" Color="#1ACF222E"/>
            <SolidColorBrush x:Key="BearStatusErrorFgBrush" Color="#CF222E"/>
            <SolidColorBrush x:Key="BearNeutralPillBgBrush" Color="#0D000000"/>
            <SolidColorBrush x:Key="BearNeutralPillFgBrush" Color="#B3000000"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BearAccentBrush" Color="#E04F44"/>
            <SolidColorBrush x:Key="BearAccentHoverBrush" Color="#EB6358"/>
            <SolidColorBrush x:Key="BearAccentPressedBrush" Color="#C93F35"/>
            <SolidColorBrush x:Key="BearAccentBorderBrush" Color="#40FF8A80"/>
            <SolidColorBrush x:Key="BearAccentSubtleBrush" Color="#24E04F44"/>
            <SolidColorBrush x:Key="BearAccentSubtleBorderBrush" Color="#59E04F44"/>
            <SolidColorBrush x:Key="BearAccentForegroundBrush" Color="#FF8A80"/>
            <SolidColorBrush x:Key="BearOnAccentBrush" Color="#FFFFFF"/>

            <SolidColorBrush x:Key="BearCardBrush" Color="#B3242429"/>
            <SolidColorBrush x:Key="BearElevatedSurfaceBrush" Color="#D92B2B32"/>
            <SolidColorBrush x:Key="BearCardBorderBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="BearSubtleHoverBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="BearThumbnailBgBrush" Color="#FF18181C"/>

            <SolidColorBrush x:Key="BearStatusRunningBgBrush" Color="#263B82F6"/>
            <SolidColorBrush x:Key="BearStatusRunningFgBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="BearStatusSuccessBgBrush" Color="#243FB950"/>
            <SolidColorBrush x:Key="BearStatusSuccessFgBrush" Color="#3FB950"/>
            <SolidColorBrush x:Key="BearStatusWarningBgBrush" Color="#26E5A93C"/>
            <SolidColorBrush x:Key="BearStatusWarningFgBrush" Color="#E5A93C"/>
            <SolidColorBrush x:Key="BearStatusErrorBgBrush" Color="#26F85149"/>
            <SolidColorBrush x:Key="BearStatusErrorFgBrush" Color="#F85149"/>
            <SolidColorBrush x:Key="BearNeutralPillBgBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="BearNeutralPillFgBrush" Color="#C7FFFFFF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Semantic theme brushes keep the same hierarchy in dark, light and glass modes. -->
    <Style x:Key="PageSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BearCardBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BearCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="InsetSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PageSurfaceStyle}">
        <Setter Property="Background" Value="{ThemeResource BearElevatedSurfaceBrush}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="FormSectionStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource BearCardBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BearCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
    </Style>
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>
    <Style x:Key="SupportingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="BearTabularTextStyle" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="BearSubtlePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BearNeutralPillBgBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BearCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BearPrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BearAccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource BearOnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BearAccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource BearAccentHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource BearAccentPressedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PageActionStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="IconActionStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style x:Key="PagePasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style x:Key="PageComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="180"/>
    </Style>
    <Style x:Key="PageSearchStyle" TargetType="AutoSuggestBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style x:Key="PageNumberBoxStyle" TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="180"/>
    </Style>
    <Style x:Key="PreferenceCardStyle" TargetType="community:SettingsCard">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PreferenceExpanderStyle" TargetType="community:SettingsExpander">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <DataTemplate x:Key="DialogHeadingTemplate">
        <TextBlock Text="{Binding}" Style="{StaticResource PageHeadingStyle}"/>
    </DataTemplate>
</ResourceDictionary>
