<ContentDialog
    x:Class="Nickvision.Parabolic.WinUI.Views.KeyringDialog"
    x:Name="DialogRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:parabolic="using:Nickvision.Parabolic.WinUI.Helpers"
    xmlns:nickvision="using:Nickvision.Desktop.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary" Loaded="Dialog_Loaded">
    <Grid Width="498" MaxWidth="498" ColumnSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="SearchBox" Grid.Row="0" QueryIcon="Find" TextChanged="SearchBox_TextChanged"/>

        <Button x:Name="BtnAdd" Grid.Row="1" HorizontalAlignment="Left" Margin="0,8,0,8" Click="Add">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;"/>
                <TextBlock x:Name="LblAdd"/>
            </StackPanel>
        </Button>

        <ScrollViewer Grid.Row="2" FlowDirection="LeftToRight" Padding="0,0,20,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <nickvision:ViewStack x:Name="ViewStack" Width="478" MaxWidth="478" FlowDirection="{Binding FlowDirection, ElementName=DialogRoot}">
                <nickvision:ViewStack.Pages>
                    <nickvision:StatusPage x:Name="StatusNone" Margin="0,24,0,24" Glyph="&#xF540;" IsCompact="True"/>

                    <nickvision:StatusPage x:Name="StatusNoneSearch" Margin="0,24,0,24" Glyph="&#xE721;" IsCompact="True"/>

                    <ListView x:Name="ListCredentials" SelectionMode="None" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="parabolic:BindableCredentialSelectionItem">
                                <community:SettingsCard HorizontalAlignment="Stretch">
                                    <community:SettingsCard.Resources>
                                        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                    </community:SettingsCard.Resources>
                                    <community:SettingsCard.Header>
                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" TextWrapping="Wrap"/>
                                    </community:SettingsCard.Header>
                                    <community:SettingsCard.Description>
                                        <TextBlock Text="{x:Bind Value.Url, Mode=OneWay}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
                                    </community:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Click="Edit" Tag="{x:Bind Value, Mode=OneWay}">
                                            <Button.Content>
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70F;" FontSize="18"/>
                                            </Button.Content>
                                        </Button>

                                        <Button Click="Remove" Tag="{x:Bind Value, Mode=OneWay}">
                                            <Button.Content>
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="18"/>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </community:SettingsCard>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </nickvision:ViewStack.Pages>
            </nickvision:ViewStack>
        </ScrollViewer>
    </Grid>
</ContentDialog>
