<Window
    x:Class="Nickvision.Parabolic.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nickvision.Parabolic.WinUI.Views"
    xmlns:nickvision="using:Nickvision.Desktop.WinUI.Controls"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:parabolic="using:Nickvision.Parabolic.WinUI.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <!-- Native title-bar hit regions use window-root coordinates. Keep this root
         LTR so their physical positions match the screen; localize MainGrid only. -->
    <Grid x:Name="WindowRoot" FlowDirection="LeftToRight">
        <Grid x:Name="MainGrid" Loaded="Window_Loaded">
            <Grid.Resources>
                <Style x:Key="CaptionButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="48"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TitleBar x:Name="TitleBar" Grid.Column="1" FlowDirection="{Binding FlowDirection, ElementName=MainGrid}" IsBackButtonVisible="False" BackRequested="TitleBar_BackRequested">
                    <TitleBar.LeftHeader>
                        <Grid Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ImageIcon Grid.Column="0" VerticalAlignment="Center" Height="18" Source="/Assets/org.nickvision.tubeconverter.ico"/>

                            <TextBlock x:Name="LblTitle" Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>

                            <MenuBar x:Name="TopMenuBar" Grid.Column="2" Padding="0" HorizontalAlignment="Left">
                                <MenuBarItem x:Name="MenuFile">
                                    <MenuFlyoutItem x:Name="MenuAddDownload" Click="AddDownload">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="N" Modifiers="Control"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator/>

                                    <MenuFlyoutItem x:Name="MenuExit" Click="Exit">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="F4" Modifiers="Menu"/>

                                            <KeyboardAccelerator Key="Q" Modifiers="Control"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE894;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuBarItem>

                                <MenuBarItem x:Name="MenuEdit">
                                    <MenuFlyoutItem x:Name="MenuKeyring" Click="Keyring">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="K" Modifiers="Control"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72E;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem x:Name="MenuSettings" Click="Settings">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="I" Modifiers="Control"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuBarItem>

                                <MenuBarItem x:Name="MenuView">
                                    <MenuFlyoutItem x:Name="MenuHistory" Click="History">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="H" Modifiers="Control"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE81C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuBarItem>

                                <MenuBarItem x:Name="MenuDownloads">
                                    <MenuFlyoutItem x:Name="MenuStopAllRemaining" Click="StopAllRemaining">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71A;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem x:Name="MenuRetryAllFailed" Click="RetryAllFailed">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="R" Modifiers="Control,Shift"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator/>

                                    <MenuFlyoutItem x:Name="MenuClearAllQueued" Click="ClearAllQueued">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE894;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem x:Name="MenuClearAllCompleted" Click="ClearAllCompleted">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE894;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuBarItem>

                                <MenuBarItem x:Name="MenuHelp">
                                    <MenuFlyoutItem x:Name="MenuCheckForUpdates" Click="CheckForUpdates">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xF0C5;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator/>

                                    <MenuFlyoutItem x:Name="MenuGitHubRepo" Click="GitHubRepo">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8F1;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem x:Name="MenuReportABug" Click="ReportABug">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="I" Modifiers="Control,Shift"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEBE8;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutItem x:Name="MenuDiscussions" Click="Discussions">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8F2;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator/>

                                    <MenuFlyoutItem x:Name="MenuAbout" Click="About">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="F1" Modifiers="None"/>
                                        </MenuFlyoutItem.KeyboardAccelerators>

                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuBarItem>
                            </MenuBar>
                        </Grid>
                    </TitleBar.LeftHeader>

                    <TitleBar.RightHeader>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                            <Button x:Name="BtnPreview" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                                <Button.Content>
                                    <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" Glyph="&#xE794;"/>
                                </Button.Content>

                                <Button.Flyout>
                                    <Flyout>
                                        <TextBlock VerticalAlignment="Center" x:Name="LblPreview" TextWrapping="Wrap"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="BtnUpdateProgress" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                                <Button.Content>
                                    <ProgressRing x:Name="RingUpdateProcess" Width="24" Height="24" IsIndeterminate="False"/>
                                </Button.Content>

                                <Button.Flyout>
                                    <Flyout x:Name="FlyoutUpdateProgress" Placement="Bottom">
                                        <TextBlock VerticalAlignment="Center" x:Name="LblUpdateProgress" TextWrapping="WrapWholeWords"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </TitleBar.RightHeader>
                </TitleBar>

                <!-- Physical left-side caption controls for RTL; LTR uses Windows caption buttons. -->
                <Grid Grid.Column="0">
                    <StackPanel x:Name="RtlCaptionButtons" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                        <Button x:Name="BtnWindowClose" Style="{StaticResource CaptionButtonStyle}" Click="Exit">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A52317"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                            </Button.Resources>
                            <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8BB;" FontSize="10"/>
                        </Button>
                        <Button x:Name="BtnWindowMaximize" Style="{StaticResource CaptionButtonStyle}" Click="WindowMaximize_Click">
                            <FontIcon VerticalAlignment="Center" x:Name="IconWindowMaximize" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE922;" FontSize="10"/>
                        </Button>
                        <Button x:Name="BtnWindowMinimize" Style="{StaticResource CaptionButtonStyle}" Click="WindowMinimize_Click">
                            <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE921;" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

            </Grid>

            <MenuFlyoutSeparator x:Name="TopSeparator" Grid.Row="1"/>

            <Grid Grid.Row="2">
                <nickvision:ViewStack x:Name="ViewStack" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <nickvision:ViewStack.Pages>
                        <StackPanel Margin="48,48,48,48" HorizontalAlignment="Stretch" Orientation="Vertical" Spacing="12">
                            <Image FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="64" Height="64" Source="/Assets/org.nickvision.tubeconverter.ico"/>

                            <TextBlock x:Name="LblHomeTitle" HorizontalAlignment="Left" Style="{ThemeResource TitleTextBlockStyle}"/>

                            <TextBlock x:Name="LblHomeDescription" HorizontalAlignment="Left" Foreground="Gray"/>

                            <HyperlinkButton Margin="0,24,0,0" Click="AddDownload">
                                <HyperlinkButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;"/>

                                        <TextBlock VerticalAlignment="Center" x:Name="LblAddDownload"/>
                                    </StackPanel>
                                </HyperlinkButton.Content>
                            </HyperlinkButton>

                            <HyperlinkButton Click="Keyring">
                                <HyperlinkButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72E;"/>

                                        <TextBlock VerticalAlignment="Center" x:Name="LblKeyring"/>
                                    </StackPanel>
                                </HyperlinkButton.Content>
                            </HyperlinkButton>

                            <HyperlinkButton Click="Settings">
                                <HyperlinkButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;"/>

                                        <TextBlock VerticalAlignment="Center" x:Name="LblSettings"/>
                                    </StackPanel>
                                </HyperlinkButton.Content>
                            </HyperlinkButton>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Classic Downloads Toolbar (Row 0) -->
                            <Grid x:Name="ClassicDownloadsToolbar" Grid.Row="0" Margin="12,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Click="AddDownload">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;"/>

                                            <TextBlock VerticalAlignment="Center" x:Name="LblDownloadsAddDownload"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                                <CommandBar Grid.Column="2" DefaultLabelPosition="Right">
                                    <CommandBar.PrimaryCommands>
                                        <AppBarButton x:Name="BtnStopAllRemaining" Click="StopAllRemaining">
                                            <AppBarButton.Icon>
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71A;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>

                                        <AppBarButton x:Name="BtnRetryAllFailed" Click="RetryAllFailed">
                                            <AppBarButton.Icon>
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>

                                        <AppBarSeparator/>
                                    </CommandBar.PrimaryCommands>

                                    <CommandBar.SecondaryCommands>
                                        <AppBarButton x:Name="BtnClearAllQueued" Click="ClearAllQueued">
                                            <AppBarButton.Icon>
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE894;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>

                                        <AppBarButton x:Name="BtnClearAllCompleted" Click="ClearAllCompleted">
                                            <AppBarButton.Icon>
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE894;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                    </CommandBar.SecondaryCommands>
                                </CommandBar>
                            </Grid>

                            <MenuFlyoutSeparator x:Name="ClassicDownloadsSeparator" Grid.Row="1" HorizontalAlignment="Stretch"/>

                            <NavigationView x:Name="NavViewDownloads" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                                            PaneDisplayMode="Left" OpenPaneLength="240"
                                            SelectionChanged="NavViewDownloads_SelectionChanged"
                                            ItemInvoked="NavViewDownloads_ItemInvoked">
                                <NavigationView.Resources>
                                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                                </NavigationView.Resources>

                                <NavigationView.MenuItems>
                                    <NavigationViewItem x:Name="NavDownloadsAll" Tag="0" IsSelected="True">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71D;"/>
                                        </NavigationViewItem.Icon>

                                        <NavigationViewItem.InfoBadge>
                                            <InfoBadge x:Name="InfoBadgeDownloadsAll" Style="{StaticResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed"/>
                                        </NavigationViewItem.InfoBadge>
                                    </NavigationViewItem>

                                    <NavigationViewItem x:Name="NavDownloadsRunning" Tag="1">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;"/>
                                        </NavigationViewItem.Icon>

                                        <NavigationViewItem.InfoBadge>
                                            <InfoBadge x:Name="InfoBadgeDownloadsRunning" Style="{StaticResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed"/>
                                        </NavigationViewItem.InfoBadge>
                                    </NavigationViewItem>

                                    <NavigationViewItem x:Name="NavDownloadsQueued" Tag="2">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE917;"/>
                                        </NavigationViewItem.Icon>

                                        <NavigationViewItem.InfoBadge>
                                            <InfoBadge x:Name="InfoBadgeDownloadsQueued" Style="{StaticResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed"/>
                                        </NavigationViewItem.InfoBadge>
                                    </NavigationViewItem>

                                    <NavigationViewItem x:Name="NavDownloadsCompleted" Tag="3">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE73E;"/>
                                        </NavigationViewItem.Icon>

                                        <NavigationViewItem.InfoBadge>
                                            <InfoBadge x:Name="InfoBadgeDownloadsCompleted" Style="{StaticResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed"/>
                                        </NavigationViewItem.InfoBadge>
                                    </NavigationViewItem>

                                    <NavigationViewItem x:Name="NavDownloadsFailed" Tag="4">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE783;"/>
                                        </NavigationViewItem.Icon>

                                        <NavigationViewItem.InfoBadge>
                                            <InfoBadge x:Name="InfoBadgeDownloadsFailed" Style="{StaticResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed"/>
                                        </NavigationViewItem.InfoBadge>
                                    </NavigationViewItem>
                                </NavigationView.MenuItems>

                                <NavigationView.FooterMenuItems>
                                    <NavigationViewItemSeparator x:Name="NavFooterSeparator" Visibility="Collapsed"/>

                                    <NavigationViewItem x:Name="NavHistory" Tag="History" SelectsOnInvoked="False" Visibility="Collapsed">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81C;"/>
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>

                                    <NavigationViewItem x:Name="NavKeyring" Tag="Keyring" SelectsOnInvoked="False" Visibility="Collapsed">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72E;"/>
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>

                                    <NavigationViewItem x:Name="NavSettings" Tag="Settings" SelectsOnInvoked="False" Visibility="Collapsed">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;"/>
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>

                                    <NavigationViewItem x:Name="NavAbout" Tag="Help" SelectsOnInvoked="False" Visibility="Collapsed">
                                        <NavigationViewItem.Icon>
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE897;"/>
                                        </NavigationViewItem.Icon>

                                        <FlyoutBase.AttachedFlyout>
                                            <MenuFlyout x:Name="FlyoutHelp" Placement="RightEdgeAlignedBottom">
                                                <MenuFlyoutItem x:Name="MenuPopupCheckForUpdates" Click="CheckForUpdates">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xF0C5;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>

                                                <MenuFlyoutSeparator/>

                                                <MenuFlyoutItem x:Name="MenuPopupGitHubRepo" Click="GitHubRepo">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8F1;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>

                                                <MenuFlyoutItem x:Name="MenuPopupReportABug" Click="ReportABug">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEBE8;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>

                                                <MenuFlyoutItem x:Name="MenuPopupDiscussions" Click="Discussions">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8F2;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>

                                                <MenuFlyoutSeparator/>

                                                <MenuFlyoutItem x:Name="MenuPopupAbout" Click="About">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </NavigationViewItem>
                                </NavigationView.FooterMenuItems>

                                <Grid x:Name="WorkspaceDownloadsGrid" Background="Transparent" AllowDrop="True" DragOver="Workspace_DragOver" Drop="Workspace_Drop">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Single Modern URL Command Bar (Modern Layout Only) -->
                                    <Border x:Name="QuickUrlCard" Grid.Row="0" Margin="12,8,32,4" Padding="6,6" CornerRadius="12" Visibility="Collapsed"
                                            parabolic:ScrollViewportHelper.ReserveScrollbarRight="20"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71B;" FontSize="15" Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                            <TextBox x:Name="TxtQuickUrl" Grid.Column="1" FlowDirection="LeftToRight" Height="36" VerticalContentAlignment="Center" CornerRadius="8" BorderThickness="0" Background="Transparent"
                                                     TextChanged="TxtQuickUrl_TextChanged" KeyDown="TxtQuickUrl_KeyDown"/>

                                            <Button x:Name="BtnQuickCustomize" Grid.Column="2" Height="36" Padding="14,0" CornerRadius="8"
                                                    IsEnabled="False" Click="QuickCustomize_Click">
                                                <Button.Content>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE9E9;"/>
                                                        <TextBlock VerticalAlignment="Center" x:Name="LblQuickCustomize" FontWeight="Medium"/>
                                                    </StackPanel>
                                                </Button.Content>
                                            </Button>

                                            <Button x:Name="BtnQuickDownload" Grid.Column="3" Height="36" Padding="16,0" CornerRadius="8"
                                                    Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" Click="QuickDownload_Click">
                                                <Button.Content>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE896;"/>
                                                        <TextBlock VerticalAlignment="Center" x:Name="LblQuickDownload" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button.Content>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Clipboard link suggestion (Modern Layout Only, shown when the clipboard holds a URL) -->
                                    <Border x:Name="ClipboardSuggestion" Grid.Row="1" Margin="12,2,32,4" Padding="12,6" CornerRadius="10" Visibility="Collapsed"
                                            parabolic:ScrollViewportHelper.ReserveScrollbarRight="20"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE77F;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>

                                            <TextBlock x:Name="LblClipboardPrompt" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>

                                            <TextBlock x:Name="LblClipboardUrl" Grid.Column="2" FlowDirection="LeftToRight" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>

                                            <Button x:Name="BtnClipboardUse" Grid.Column="3" Padding="12,4" CornerRadius="6" Click="ClipboardUse_Click">
                                                <TextBlock x:Name="LblClipboardUse" FontWeight="SemiBold"/>
                                            </Button>

                                            <Button x:Name="BtnClipboardDismiss" Grid.Column="4" Padding="8,4" CornerRadius="6" Background="Transparent" BorderThickness="0" Click="ClipboardDismiss_Click">
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Section header: current filter + count, batch actions only when they apply (Modern Layout Only) -->
                                    <Grid x:Name="ModernDownloadsToolbar" Grid.Row="2" Margin="12,6,32,4" ColumnSpacing="8" Visibility="Collapsed"
                                          parabolic:ScrollViewportHelper.ReserveScrollbarRight="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblModernSectionTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LblModernSectionCount" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button x:Name="BtnModernStopAllRemaining" Padding="10,5" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="StopAllRemaining">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE71A;"/>
                                                    <TextBlock VerticalAlignment="Center" x:Name="LblModernStopAllRemaining"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="BtnModernRetryAllFailed" Padding="10,5" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="RetryAllFailed">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE72C;"/>
                                                    <TextBlock VerticalAlignment="Center" x:Name="LblModernRetryAllFailed"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="BtnModernClearAllQueued" Padding="10,5" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClearAllQueued">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE894;"/>
                                                    <TextBlock VerticalAlignment="Center" x:Name="LblModernClearAllQueued"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="BtnModernClearAllCompleted" Padding="10,5" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClearAllCompleted">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE74D;"/>
                                                    <TextBlock VerticalAlignment="Center" x:Name="LblModernClearAllCompleted"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <ScrollViewer x:Name="ScrollDownloads" Grid.Row="3" FlowDirection="LeftToRight" Padding="0,0,20,0" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" parabolic:ScrollViewportHelper.ConstrainContentWidth="True">
                                        <nickvision:ViewStack x:Name="ViewStackDownloads" FlowDirection="{Binding FlowDirection, ElementName=MainGrid}">
                                            <nickvision:ViewStack.Pages>
                                                <nickvision:StatusPage x:Name="StatusNoneDownloads" Glyph="&#xE896;">
                                                    <nickvision:StatusPage.Child>
                                                        <Button x:Name="BtnClassicNoneAdd" Click="AddDownload">
                                                            <Button.Content>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;"/>

                                                                    <TextBlock VerticalAlignment="Center" x:Name="LblNoneAddDownload"/>
                                                                </StackPanel>
                                                            </Button.Content>
                                                        </Button>
                                                    </nickvision:StatusPage.Child>
                                                </nickvision:StatusPage>

                                                <ItemsRepeater x:Name="ListDownloads" Margin="12,6,12,0">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="6"/>
                                                    </ItemsRepeater.Layout>
                                                </ItemsRepeater>
                                            </nickvision:ViewStack.Pages>
                                        </nickvision:ViewStack>
                                    </ScrollViewer>

                                    <!-- Empty state with start hints (Modern Layout Only, shown when there are no downloads at all) -->
                                    <Grid x:Name="ModernEmptyState" Grid.Row="3" Margin="12,8,32,16" Visibility="Collapsed"
                                          parabolic:ScrollViewportHelper.ReserveScrollbarRight="20">
                                        <Rectangle RadiusX="16" RadiusY="16" StrokeThickness="1.5" StrokeDashArray="5,4"
                                                   Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.6"/>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24" Spacing="6">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE896;" FontSize="44" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LblEmptyTitle" Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock x:Name="LblEmptySubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords"/>

                                            <Grid Margin="0,18,0,0" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Padding="12" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel Spacing="8">
                                                        <Border HorizontalAlignment="Center" Padding="8,2" CornerRadius="5" BorderThickness="1,1,1,2" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                                                            <TextBlock Text="Ctrl+V" FontFamily="Consolas" FlowDirection="LeftToRight"/>
                                                        </Border>
                                                        <TextBlock x:Name="LblHintPaste" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Padding="12" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel Spacing="8">
                                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7C9;" FontSize="20" HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="LblHintDrag" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Padding="12" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel Spacing="8">
                                                        <Border HorizontalAlignment="Center" Padding="8,2" CornerRadius="5" BorderThickness="1,1,1,2" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                                                            <TextBlock Text="Enter" FontFamily="Consolas" FlowDirection="LeftToRight"/>
                                                        </Border>
                                                        <TextBlock x:Name="LblHintEnter" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </NavigationView>
                        </Grid>

                        <Frame x:Name="FrameCustom"/>
                    </nickvision:ViewStack.Pages>
                </nickvision:ViewStack>

                <InfoBar x:Name="InfoBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="BtnInfoBar" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>

            <ContentDialog x:Name="DlgCredential" TitleTemplate="{StaticResource DialogHeadingTemplate}" DefaultButton="Primary">
                <Border Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel Orientation="Vertical" Spacing="16">
                        <TextBlock x:Name="LblCredentialRequired"/>

                        <TextBox x:Name="TxtCredentialUrl" Style="{StaticResource PageTextBoxStyle}" IsReadOnly="True"/>

                        <TextBox x:Name="TxtCredentialUsername" Style="{StaticResource PageTextBoxStyle}"/>

                        <PasswordBox x:Name="TxtCredentialPassword" Style="{StaticResource PagePasswordBoxStyle}"/>
                    </StackPanel>
                </Border>
            </ContentDialog>
        </Grid>
    </Grid>
</Window>
