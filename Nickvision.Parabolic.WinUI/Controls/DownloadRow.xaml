<UserControl
    x:Class="Nickvision.Parabolic.WinUI.Controls.DownloadRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nickvision="using:Nickvision.Desktop.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="DownloadActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconActionStyle}"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" RowSpacing="12" Background="{ThemeResource BearCardBrush}"
          CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource BearCardBorderBrush}" Padding="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StatusStates">
                <VisualState x:Name="StatusRunningState">
                    <VisualState.Setters>
                        <Setter Target="PillStatus.Background" Value="{ThemeResource BearStatusRunningBgBrush}"/>
                        <Setter Target="IcnStatus.Foreground" Value="{ThemeResource BearStatusRunningFgBrush}"/>
                        <Setter Target="LblStatusBadge.Foreground" Value="{ThemeResource BearStatusRunningFgBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusWarningState">
                    <VisualState.Setters>
                        <Setter Target="PillStatus.Background" Value="{ThemeResource BearStatusWarningBgBrush}"/>
                        <Setter Target="IcnStatus.Foreground" Value="{ThemeResource BearStatusWarningFgBrush}"/>
                        <Setter Target="LblStatusBadge.Foreground" Value="{ThemeResource BearStatusWarningFgBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusSuccessState">
                    <VisualState.Setters>
                        <Setter Target="PillStatus.Background" Value="{ThemeResource BearStatusSuccessBgBrush}"/>
                        <Setter Target="IcnStatus.Foreground" Value="{ThemeResource BearStatusSuccessFgBrush}"/>
                        <Setter Target="LblStatusBadge.Foreground" Value="{ThemeResource BearStatusSuccessFgBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusErrorState">
                    <VisualState.Setters>
                        <Setter Target="PillStatus.Background" Value="{ThemeResource BearStatusErrorBgBrush}"/>
                        <Setter Target="IcnStatus.Foreground" Value="{ThemeResource BearStatusErrorFgBrush}"/>
                        <Setter Target="LblStatusBadge.Foreground" Value="{ThemeResource BearStatusErrorFgBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Stretch" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="96" Height="54" CornerRadius="8"
                    Background="{ThemeResource BearThumbnailBgBrush}"
                    BorderBrush="{ThemeResource BearCardBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid>
                    <FontIcon x:Name="IcnThumbnailFallback" FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE714;" FontSize="20"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image FlowDirection="LeftToRight" x:Name="ImgThumbnail" Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2,0" Orientation="Vertical" Spacing="6">
                <TextBlock x:Name="LblTitle" FontWeight="SemiBold" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" MaxLines="2"/>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PillStatus" Grid.Column="0" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                            Background="{ThemeResource BearStatusRunningBgBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon x:Name="IcnStatus" VerticalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12"
                                      Foreground="{ThemeResource BearStatusRunningFgBrush}"/>
                            <TextBlock x:Name="LblStatusBadge" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BearStatusRunningFgBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="LblStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Style="{StaticResource BearTabularTextStyle}"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>
                </Grid>

                <ProgressBar x:Name="ProgBar" HorizontalAlignment="Stretch" Minimum="0" Maximum="1"
                             Foreground="{ThemeResource BearAccentBrush}"/>

                <Grid x:Name="GridFileInfo" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblFileInfo" Grid.Column="0" FontSize="12"
                               Style="{StaticResource BearTabularTextStyle}"
                               FlowDirection="LeftToRight"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>

            <nickvision:ViewStack x:Name="ViewStackButtons" Grid.Column="2" VerticalAlignment="Center">
                <nickvision:ViewStack.Pages>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BtnPauseResume" Style="{StaticResource DownloadActionButtonStyle}" Click="PauseResume">
                            <FontIcon VerticalAlignment="Center" x:Name="FntPauseResume" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE769;"/>
                        </Button>
                        <Button x:Name="BtnStop" Style="{StaticResource DownloadActionButtonStyle}" Click="Stop">
                            <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE71A;"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BtnPlay" Style="{StaticResource DownloadActionButtonStyle}" Click="Play">
                            <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE768;"/>
                        </Button>
                        <Button x:Name="BtnCopyFile" Style="{StaticResource DownloadActionButtonStyle}" Click="CopyFile">
                            <ToolTipService.ToolTip>
                                <ToolTip x:Name="CopyFileToolTip"/>
                            </ToolTipService.ToolTip>
                            <FontIcon VerticalAlignment="Center" x:Name="FntCopyFile" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE8C8;"/>
                        </Button>
                        <Button x:Name="BtnOpenFolder" Style="{StaticResource DownloadActionButtonStyle}" Click="OpenFolder">
                            <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE838;"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BtnRetry" Style="{StaticResource DownloadActionButtonStyle}" Click="Retry">
                            <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE72C;"/>
                        </Button>
                    </StackPanel>
                </nickvision:ViewStack.Pages>
            </nickvision:ViewStack>

            <Button x:Name="BtnMore" Grid.Column="3" Style="{StaticResource DownloadActionButtonStyle}">
                <Button.Flyout>
                    <MenuFlyout x:Name="ActionsFlyout">
                        <ToggleMenuFlyoutItem x:Name="BtnShowLog" Click="ShowLog"/>
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE712;"/>
            </Button>
        </Grid>

        <Grid x:Name="GridLog" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="320"/>
            </Grid.RowDefinitions>

            <MenuFlyoutSeparator Grid.Row="0" HorizontalAlignment="Stretch"/>

            <ScrollViewer x:Name="ScrollLog" Grid.Row="1" FlowDirection="LeftToRight" Padding="0,0,16,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LblLog" FlowDirection="LeftToRight" Margin="0,0,12,0" IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
