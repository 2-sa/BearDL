<ContentDialog
    x:Class="Nickvision.Parabolic.WinUI.Views.KeyringDialog"
    x:Name="DialogRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nickvision="using:Nickvision.Desktop.WinUI.Controls"
    xmlns:parabolic="using:Nickvision.Parabolic.WinUI.Helpers"
    Style="{StaticResource DefaultContentDialogStyle}"
    TitleTemplate="{StaticResource DialogHeadingTemplate}"
    DefaultButton="Primary" Loaded="Dialog_Loaded">
    <Grid Width="498" MaxWidth="498" FlowDirection="LeftToRight" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource InsetSurfaceStyle}" Margin="0,0,20,0" FlowDirection="{Binding FlowDirection, ElementName=DialogRoot}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="SearchBox" Style="{StaticResource PageSearchStyle}" QueryIcon="Find" TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="BtnAdd" Grid.Row="1" Style="{StaticResource PageActionStyle}" HorizontalAlignment="Left" Click="Add">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE710;"/>
                        <TextBlock VerticalAlignment="Center" x:Name="LblAdd"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" MaxHeight="420" MinHeight="180" FlowDirection="LeftToRight" Padding="0,0,20,0" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" parabolic:ScrollViewportHelper.ConstrainContentWidth="True">
            <nickvision:ViewStack x:Name="ViewStack" FlowDirection="{Binding FlowDirection, ElementName=DialogRoot}">
                <nickvision:ViewStack.Pages>

                    <nickvision:StatusPage x:Name="StatusNone" Margin="0,24" Glyph="&#xF540;" IsCompact="True"/>
                    <nickvision:StatusPage x:Name="StatusNoneSearch" Margin="0,24" Glyph="&#xE721;" IsCompact="True"/>
                    <ListView x:Name="ListCredentials" SelectionMode="None" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="parabolic:BindableCredentialSelectionItem">
                                <Border Style="{StaticResource PageSurfaceStyle}" Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind Value.Url, Mode=OneWay}" Style="{StaticResource SupportingTextStyle}" FlowDirection="LeftToRight" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Value.Url, Mode=OneWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Name="EditAction" Style="{StaticResource IconActionStyle}" Loaded="ActionButton_Loaded" Click="Edit" Tag="{x:Bind Value, Mode=OneWay}">
                                                <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70F;" FontSize="16"/>
                                            </Button>
                                            <Button Name="RemoveAction" Style="{StaticResource IconActionStyle}" Loaded="ActionButton_Loaded" Click="Remove" Tag="{x:Bind Value, Mode=OneWay}">
                                                <FontIcon VerticalAlignment="Center" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </nickvision:ViewStack.Pages>
            </nickvision:ViewStack>
        </ScrollViewer>
    </Grid>
</ContentDialog>
